# Copy this file to .env and fill in the key(s) for the provider(s) you use.
# You only need the key for the provider you actually run with.

# --provider anthropic (default) — https://platform.claude.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --provider openai — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key

# --provider groq (fast, generous free tier) — https://console.groq.com/keys
# GROQ_API_KEY=gsk_your-groq-key

# --provider custom — any OpenAI-compatible endpoint
# (Ollama, OpenRouter, Together, Mistral, DeepSeek, vLLM, LM Studio, ...)
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_API_KEY=ollama            # some local servers accept any value
